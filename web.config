<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse-proxy config: forwards all requests to the Waitress WSGI
  server (wsgi.py) running as a Windows Service on 127.0.0.1:8000.

  Requires the URL Rewrite and Application Request Routing (ARR) modules,
  and ARR proxy must be enabled server-wide first:
    IIS Manager -> (server node) -> Application Request Routing Cache
    -> Server Proxy Settings... -> check "Enable proxy" -> Apply

  Place this file in the IIS site's physical path (it does not need to be
  next to app.py/wsgi.py — the site's root can be an otherwise-empty
  directory that just proxies through to the Waitress process).

  Adjust the backend port here if PORT/WSGI_HOST differ from wsgi.py's
  defaults.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ReverseProxyToWaitress" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>